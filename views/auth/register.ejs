<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Đăng ký - Bookstore</title>
    <link href="/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/site-menu.css">
</head>
<body>
    <%- include('../partials/menu') %>

    <div class="main-content">
        <div class="auth-card">
            <h2 class="auth-title">ĐĂNG KÝ</h2>

            <% if (locals.registerError) { %>
                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        if (window.showNotice) window.showNotice(<%- JSON.stringify(registerError) %>, 'error');
                    });
                </script>
            <% } %>

            <form action="/register" method="POST">
                <div class="mb-3">
                    <label class="form-label fw-bold">Họ và tên</label>
                    <input type="text" class="form-control" name="full_name" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Email</label>
                    <input type="email" class="form-control" name="email" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Tên đăng nhập</label>
                    <input type="text" class="form-control" name="username" pattern="^[a-zA-Z0-9_]+$" title="Username chỉ cho phép chữ cái, số hoặc dấu _" required>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold">Mật khẩu</label>
                    <input type="password" class="form-control" name="password" required>
                </div>

                <input type="hidden" name="role" value="user">

                <button type="submit" class="btn-auth">ĐĂNG KÝ</button>
            </form>

            <div class="text-center mt-4">
                <p class="text-muted">Đã có tài khoản? <a href="/login" class="text-decoration-none fw-bold text-danger">Đăng nhập ngay</a></p>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
    <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
</body>
</html>