<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Đăng nhập - Bookstore</title>
    <link href="/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/site-menu.css">
</head>
<body>
    <%- include('../partials/menu') %>

    <div class="main-content auth-main">
        <div class="auth-card">
            <h2 class="auth-title">Đăng nhập</h2>

            <% if (locals.registerSuccess) { %>
                <div class="alert alert-success" role="alert"><%= registerSuccess %></div>
            <% } %>
            <% if (locals.loginError) { %>
                <div class="alert alert-danger" role="alert"><%= loginError %></div>
            <% } %>

            <form action="/login" method="POST" data-auth-form="login">
                <div class="auth-field-wrap mb-3">
                    <label class="form-label fw-bold" for="pageLoginUsername">Tên đăng nhập</label>
                    <input type="text" class="form-control" name="username" id="pageLoginUsername" value="<%= typeof prefillUsername !== 'undefined' ? prefillUsername : '' %>" autocomplete="username" autocapitalize="off">
                    <div class="auth-field-error small text-danger mt-1 d-none" aria-live="polite"></div>
                </div>
                <div class="auth-field-wrap mb-3">
                    <label class="form-label fw-bold" for="pageLoginPassword">Mật khẩu</label>
                    <div class="input-group">
                        <input type="password" class="form-control" name="password" id="pageLoginPassword" autocomplete="current-password">
                        <button type="button" class="btn btn-outline-secondary toggle-password" aria-label="Hiển thị mật khẩu" aria-pressed="false">
                            <i class="fas fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="auth-field-error small text-danger mt-1 d-none" aria-live="polite"></div>
                </div>
                <div class="text-end mb-3">
                    <a href="/forgot-password" class="text-decoration-none small text-muted">Quên mật khẩu?</a>
                </div>
                <button type="submit" class="btn-auth">Đăng nhập</button>
            </form>

            <div class="text-center mt-4">
                <p class="text-muted mb-0">Chưa có tài khoản? <a href="/register" class="text-decoration-none fw-bold text-danger">Đăng ký ngay</a></p>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
