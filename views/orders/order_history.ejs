<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Lịch sử đơn hàng - Bookstore</title>
    <link href="/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/site-menu.css">
</head>
<body class="order-history-page">
    <%- include('../partials/menu') %>

    <div class="main-content">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                <h4 class="mb-0 fw-bold text-uppercase"><i class="fas fa-history me-2 text-danger"></i> Lịch sử đơn hàng</h4>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="order-poll-hint small text-muted d-none d-md-inline" id="orderPollHint" title="Trạng thái đồng bộ khi quản trị cập nhật đơn hàng">
                        <i class="fas fa-sync-alt fa-spin me-1 d-none" id="orderPollSpinner"></i>
                        Cập nhật tự động
                    </span>
                    <a href="/" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i> Quay về</a>
                </div>
            </div>

            <% const statusLabels = typeof OrderStatusLabels !== 'undefined' ? OrderStatusLabels : {}; %>

            <% if (orders && orders.length > 0) { %>
                <p class="text-muted small mb-3">Bạn có <strong><%= orders.length %></strong> đơn hàng.</p>
                <% orders.forEach(order => {
                    const statusText = statusLabels[order.status] || 'Chờ duyệt';
                %>
                    <div class="order-card" data-order-id="<%= order.id %>" data-order-status="<%= order.status %>">
                        <div class="order-header">
                            <div>
                                <span class="fw-bold me-2">Đơn hàng #<%= order.id %></span>
                                <span class="text-muted small"><%= new Date(order.order_date).toLocaleDateString('vi-VN') %></span>

                                <% if (order.tracking_code) { %>
                                    <span class="badge bg-info text-dark ms-2"><i class="fas fa-truck me-1"></i> <%= order.tracking_code %></span>
                                <% } %>
                            </div>
                            <div class="order-status status-<%= order.status %>" data-role="order-status-badge"><%= statusText %></div>
                        </div>

                        <div class="order-body">
                            <%- include('partials/order_progress_3', { order }) %>

                            <% if (order.items && order.items.length > 0) { %>
                                <% order.items.forEach(item => { %>
                                    <div class="order-item">
                                        <%
                                            let imgSrc = item.image_url;
                                            if (imgSrc && !imgSrc.startsWith('http')) imgSrc = '/images/' + imgSrc;
                                        %>
                                        <img src="<%= imgSrc || '/images/default.jpg' %>" class="item-img" onerror="this.src='https://picsum.photos/60/80'">
                                        <div class="item-info">
                                            <div class="item-name"><%= item.name %></div>
                                            <div class="item-meta">x<%= item.quantity %></div>
                                        </div>
                                        <div class="item-price"><%= Number(item.price_at_purchase).toLocaleString('vi-VN') %> đ</div>
                                    </div>
                                <% }); %>
                            <% } %>
                        </div>
                        <div class="order-footer">
                            <span class="text-muted small">Phương thức: <b><%= order.payment_method || 'COD' %></b></span>
                            <div>
                                <span class="total-label me-2">Tổng tiền:</span>
                                <span class="total-price"><%= Number(order.final_total).toLocaleString('vi-VN') %> đ</span>
                            </div>
                        </div>
                        <div class="order-card-actions">
                            <a href="/orders/<%= order.id %>" class="btn btn-sm btn-outline-danger"><i class="fas fa-file-invoice me-1"></i> Xem chi tiết</a>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-clipboard-list"></i>
                    <h5>Bạn chưa có đơn hàng nào</h5>
                    <p class="mb-4">Hãy khám phá thêm các sản phẩm thú vị tại BookTotal nhé!</p>
                    <a href="/" class="btn-shop">Mua sắm ngay</a>
                </div>
            <% } %>
        </div>
    </div>

    <script id="orderStatusLabelsJson" type="application/json"><%- JSON.stringify(statusLabels) %></script>

    <%- include('../partials/footer') %>
    <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
    <script>
(function () {
    var POLL_MS = 25000;
    var statusLabels = {};
    try {
        var el = document.getElementById('orderStatusLabelsJson');
        if (el && el.textContent) statusLabels = JSON.parse(el.textContent);
    } catch (e) {}

    var PROGRESS_BY_STATUS = {
        PENDING:     { fill: '8%',  steps: ['current', 'upcoming', 'upcoming'] },
        CONFIRMED:   { fill: '36%', steps: ['done', 'upcoming', 'upcoming'] },
        PROCESSING:  { fill: '36%', steps: ['done', 'upcoming', 'upcoming'] },
        SHIPPED:     { fill: '64%', steps: ['done', 'current', 'upcoming'] },
        DELIVERING:  { fill: '64%', steps: ['done', 'current', 'upcoming'] },
        COMPLETED:   { fill: '100%', steps: ['done', 'done', 'done'] }
    };

    function setStepClasses(stepEl, state) {
        if (!stepEl) return;
        stepEl.classList.remove('done', 'current', 'upcoming');
        stepEl.classList.add(state);
    }

    function applyProgressToCard(card, status) {
        if (!card) return;
        card.setAttribute('data-order-status', status);

        var badge = card.querySelector('[data-role="order-status-badge"]');
        if (badge) {
            badge.textContent = statusLabels[status] || status;
            badge.className = 'order-status status-' + status;
            badge.setAttribute('data-role', 'order-status-badge');
        }

        var track = card.querySelector('[data-role="order-progress"]');
        if (status === 'CANCELLED') {
            if (track && track.parentNode) {
                var note = document.createElement('div');
                note.className = 'order-cancelled-note';
                note.innerHTML = '<i class="fas fa-ban me-2"></i> Đơn hàng này đã bị hủy.';
                track.parentNode.replaceChild(note, track);
            }
            return;
        }

        if (!track) return;

        var cfg = PROGRESS_BY_STATUS[status] || PROGRESS_BY_STATUS.PENDING;
        var fill = track.querySelector('[data-role="progress-fill"]');
        if (fill) fill.style.width = cfg.fill;

        setStepClasses(track.querySelector('[data-role="step-1"]'), cfg.steps[0]);
        setStepClasses(track.querySelector('[data-role="step-2"]'), cfg.steps[1]);
        setStepClasses(track.querySelector('[data-role="step-3"]'), cfg.steps[2]);
    }

    function syncFromPayload(list) {
        if (!list || !list.length) return;
        var byId = {};
        list.forEach(function (o) { byId[o.id] = o.status; });
        document.querySelectorAll('.order-card[data-order-id]').forEach(function (card) {
            var id = parseInt(card.getAttribute('data-order-id'), 10);
            if (!byId[id]) return;
            var prev = card.getAttribute('data-order-status');
            if (prev === byId[id]) return;
            applyProgressToCard(card, byId[id]);
        });
    }

    function poll() {
        var spinner = document.getElementById('orderPollSpinner');
        if (spinner) spinner.classList.remove('d-none');
        fetch('/orders/status-updates', { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data && data.success && data.orders) syncFromPayload(data.orders);
            })
            .catch(function () {})
            .finally(function () {
                if (spinner) spinner.classList.add('d-none');
            });
    }

    var timer;
    function startPolling() {
        if (!document.querySelector('.order-card[data-order-id]')) return;
        timer = setInterval(poll, POLL_MS);
        document.addEventListener('visibilitychange', function () {
            if (document.hidden) return;
            poll();
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        startPolling();
    });
})();
    </script>
</body>
</html>
