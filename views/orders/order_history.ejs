<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Lịch sử đơn hàng - Bookstore</title>
    <link href="/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/site-menu.css">
</head>
<body class="order-history-page">
    <%- include('../partials/menu') %>

    <div class="main-content">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                <h4 class="mb-0 fw-bold text-uppercase"><i class="fas fa-history me-2 text-danger"></i> Lịch sử đơn hàng</h4>
                <a href="/" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i> Quay về</a>
            </div>

            <% if (orders && orders.length > 0) { %>
                <% orders.forEach(order => {
                    let statusText = 'Chờ xác nhận';
                    let progressWidth = '0%';
                    let activeStep = 1;

                    switch(order.status) {
                        case 'PENDING': statusText = 'Chờ xác nhận'; progressWidth = '0%'; activeStep = 1; break;
                        case 'CONFIRMED': statusText = 'Đã xác nhận'; progressWidth = '33%'; activeStep = 2; break;
                        case 'PROCESSING': statusText = 'Đang xử lý'; progressWidth = '33%'; activeStep = 2; break;
                        case 'SHIPPED': statusText = 'Đã giao VC'; progressWidth = '66%'; activeStep = 3; break;
                        case 'DELIVERING': statusText = 'Đang giao hàng'; progressWidth = '66%'; activeStep = 3; break;
                        case 'COMPLETED': statusText = 'Hoàn thành'; progressWidth = '100%'; activeStep = 4; break;
                        case 'CANCELLED': statusText = 'Đã hủy'; progressWidth = '0%'; activeStep = 0; break;
                    }
                %>
                    <div class="order-card">
                        <div class="order-header">
                            <div>
                                <span class="fw-bold me-2">Đơn hàng #<%= order.id %></span>
                                <span class="text-muted small"><%= new Date(order.order_date).toLocaleDateString('vi-VN') %></span>

                                <% if (order.tracking_code) { %>
                                    <span class="badge bg-info text-dark ms-2"><i class="fas fa-truck me-1"></i> <%= order.tracking_code %></span>
                                <% } %>
                            </div>
                            <div class="order-status status-<%= order.status %>"><%= statusText %></div>
                        </div>

                        <div class="order-body">
                            <% if (order.status !== 'CANCELLED') { %>
                                <div class="progress-track">
                                    <div class="progress-line"><div class="progress-line-fill" style="width: <%= progressWidth %>;"></div></div>

                                    <div class="step <%= activeStep >= 1 ? 'active' : '' %>">
                                        <div class="step-icon"><i class="fas fa-file-alt"></i></div>
                                        Đặt hàng
                                    </div>
                                    <div class="step <%= activeStep >= 2 ? 'active' : '' %>">
                                        <div class="step-icon"><i class="fas fa-box"></i></div>
                                        Đóng gói
                                    </div>
                                    <div class="step <%= activeStep >= 3 ? 'active' : '' %>">
                                        <div class="step-icon"><i class="fas fa-truck"></i></div>
                                        Vận chuyển
                                    </div>
                                    <div class="step <%= activeStep >= 4 ? 'active' : '' %>">
                                        <div class="step-icon"><i class="fas fa-star"></i></div>
                                        Hoàn thành
                                    </div>
                                </div>
                            <% } else { %>
                                <div class="order-cancelled-note">
                                    <i class="fas fa-ban me-2"></i> Đơn hàng này đã bị hủy.
                                </div>
                            <% } %>

                            <% if (order.items && order.items.length > 0) { %>
                                <% order.items.forEach(item => { %>
                                    <div class="order-item">
                                        <%
                                            let imgSrc = item.image_url;
                                            if (imgSrc && !imgSrc.startsWith('http')) imgSrc = '/images/' + imgSrc;
                                        %>
                                        <img src="<%= imgSrc || '/images/default.jpg' %>" class="item-img" onerror="this.src='https://picsum.photos/60/80'">
                                        <div class="item-info">
                                            <div class="item-name"><%= item.name %></div>
                                            <div class="item-meta">x<%= item.quantity %></div>
                                        </div>
                                        <div class="item-price"><%= Number(item.price_at_purchase).toLocaleString('vi-VN') %> đ</div>
                                    </div>
                                <% }); %>
                            <% } %>
                        </div>
                        <div class="order-footer">
                            <span class="text-muted small">Phương thức: <b><%= order.payment_method || 'COD' %></b></span>
                            <div>
                                <span class="total-label me-2">Tổng tiền:</span>
                                <span class="total-price"><%= Number(order.final_total).toLocaleString('vi-VN') %> đ</span>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-clipboard-list"></i>
                    <h5>Bạn chưa có đơn hàng nào</h5>
                    <p class="mb-4">Hãy khám phá thêm các sản phẩm thú vị tại BookTotal nhé!</p>
                    <a href="/" class="btn-shop">Mua sắm ngay</a>
                </div>
            <% } %>
        </div>
    </div>

    <%- include('../partials/footer') %>
    <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
</body>
</html>
