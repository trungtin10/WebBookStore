<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Chỉnh Sửa Người Dùng - Admin</title>
    <link href="/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
        }

        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        }

        .card-header {
            background: white;
            border-bottom: 1px solid #eee;
            padding: 20px 30px;
            border-radius: 12px 12px 0 0 !important;
        }

        .form-label {
            font-weight: 600;
            color: #555;
            font-size: 0.9rem;
        }

        .form-control,
        .form-select {
            padding: 10px 15px;
            border-radius: 8px;
            border: 1px solid #dee2e6;
        }

        .form-control:focus {
            border-color: #1a1a2e;
            box-shadow: 0 0 0 3px rgba(26, 26, 46, 0.1);
        }

        .btn-save {
            background-color: #1a1a2e;
            color: white;
            font-weight: 600;
            padding: 10px 30px;
            border-radius: 8px;
            border: none;
            transition: 0.3s;
        }

        .btn-save:hover {
            background-color: #0f0f1a;
            transform: translateY(-2px);
        }

        .invalid-feedback {
            display: block;
            font-size: 0.85rem;
            margin-top: 5px;
        }
    </style>
</head>

<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <%- include('../partials/menu') %>

                <!-- Main Content -->
                <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">

                    <div class="container py-5">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h3 class="fw-bold text-dark"><i class="fas fa-user-edit text-primary me-2"></i> Chỉnh Sửa
                                Người Dùng: <%= userRow.username %>
                            </h3>
                            <div class="d-flex align-items-center">
                                <a href="/admin/user" class="btn btn-outline-secondary"><i
                                        class="fas fa-arrow-left me-2"></i> Quay lại</a>
                                <%- include('../partials/account_dropdown') %>
                            </div>
                        </div>

                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <div class="card">
                                    <div class="card-header">
                                        <h5 class="mb-0">Cập nhật thông tin</h5>
                                    </div>
                                    <div class="card-body p-4">

                                        <% let errs=(locals.errors && locals.errors.length> 0) ? locals.errors[0] : {};
                                            let data = (locals.formData) ? locals.formData : userRow;
                                            %>

                                            <form action="/admin/user/edit/<%= userRow.id %>" method="POST">
                                                <div class="mb-3">
                                                    <label class="form-label">Họ và tên</label>
                                                    <input type="text" name="full_name" class="form-control"
                                                        value="<%= data.full_name || '' %>" required>
                                                </div>

                                                <div class="row">
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label">Tên đăng nhập <span
                                                                class="text-muted">(Không thể
                                                                đổi)</span></label>
                                                        <input type="text" name="username" class="form-control"
                                                            value="<%= userRow.username %>" readonly disabled>
                                                    </div>
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label">Email <span
                                                                class="text-danger">*</span></label>
                                                        <input type="email" name="email"
                                                            class="form-control <%= errs.email ? 'is-invalid' : '' %>"
                                                            value="<%= data.email || '' %>" required>
                                                        <% if (errs.email) { %>
                                                            <div class="invalid-feedback">
                                                                <%= errs.email %>
                                                            </div>
                                                            <% } %>
                                                    </div>
                                                </div>

                                                <div class="row">
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label">Mật khẩu mới <span
                                                                class="text-muted fw-normal">(Để
                                                                trống nếu không đổi)</span></label>
                                                        <input type="password" name="password" class="form-control"
                                                            placeholder="Nhập để đổi mật khẩu">
                                                    </div>
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label">Vai trò</label>
                                                        <select name="role" class="form-select">
                                                            <option value="user" <%=data.role==='user' ? 'selected' : ''
                                                                %>>Thành viên
                                                                (User)</option>
                                                            <option value="admin" <%=data.role==='admin' ? 'selected'
                                                                : '' %>>Quản trị
                                                                viên (Admin)</option>
                                                        </select>
                                                    </div>
                                                </div>

                                                <div class="mt-4 text-end">
                                                    <button type="submit" class="btn btn-save">
                                                        <i class="fas fa-save me-2"></i> LƯU THAY ĐỔI
                                                    </button>
                                                </div>
                                            </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
        </div>
    </div>
</body>

</html>