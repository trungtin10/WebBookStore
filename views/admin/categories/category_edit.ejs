<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Sửa Danh Mục - Admin</title>
    <link href="/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
        }

        .admin-header {
            background-color: #1a1a2e;
            color: white;
            padding: 15px 0;
            margin-bottom: 30px;
            display: none;
        }

        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        }
    </style>
</head>

<body>
    <div class="container-fluid">
        <div class="row">
            <%- include('../partials/menu') %>

                <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                    <div
                        class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                        <h1 class="h2"><i class="fas fa-edit me-2"></i> CẬP NHẬT DANH MỤC</h1>
                        <div class="d-flex align-items-center">
                            <a href="/admin/categories" class="btn btn-sm btn-outline-secondary me-2"><i
                                    class="fas fa-arrow-left me-1"></i> Quay lại</a>
                            <%- include('../partials/account_dropdown') %>
                        </div>
                    </div>

                    <div class="container pb-5">
                        <div class="card p-4">
                            <form action="/admin/categories/edit/<%= category.id %>" method="POST">

                                <div class="row mb-3">
                                    <div class="col-md-12">
                                        <label class="form-label fw-bold">Tên danh mục <span
                                                class="text-danger">*</span></label>
                                        <input type="text" name="name" class="form-control" value="<%= category.name %>"
                                            required>
                                    </div>
                                </div>

                                <div class="text-end mt-4">
                                    <button type="submit" class="btn btn-primary fw-bold"><i class="fas fa-save"></i>
                                        Cập nhật</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </main>
        </div>
    </div>
    <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
</body>

</html>